# NEXUS / ReconX Environment Variables

# Groq (free tier - recommended primary LLM)
GROQ_API_KEY=

# Google AI Studio (free, 1M token context window)
GEMINI_API_KEY=

# Anthropic Claude (optional, premium exploit reasoning)
ANTHROPIC_API_KEY=

# OpenAI (optional fallback)
OPENAI_API_KEY=

# ProjectDiscovery interactsh (OAST for blind vulnerability verification)
INTERACTSH_SERVER=oast.pro
INTERACTSH_TOKEN=

# NVD API key (optional, increases rate limit from 5 to 50 req/30s)
NVD_API_KEY=
